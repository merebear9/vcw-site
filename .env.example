# -----------------------------------------------------------------------------
# Vermilion County Watchdog — environment variables
# Copy this file to .env (local dev) or configure these in your host's
# environment settings (Vercel, VPS, etc.) for production.
# -----------------------------------------------------------------------------

# Database — PostgreSQL. Works with Neon, Vercel Postgres, Supabase, RDS, or
# a self-hosted Postgres on a VPS. For local development, either point this
# at a free Neon/Vercel Postgres branch, or run Postgres locally (see README).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Google Sign-In (optional — omit to disable Google as a sign-in option)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic-link sign-in (SMTP — optional, omit to disable email sign-in)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="vermilioncountywatchdog@gmail.com"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: pre-created Stripe recurring Price IDs. If omitted, checkout
# creates prices dynamically at the amounts defined in lib/stripe.ts.
STRIPE_PRICE_COMMUNITY_MONTH=""
STRIPE_PRICE_COMMUNITY_YEAR=""
STRIPE_PRICE_INVESTIGATOR_MONTH=""
STRIPE_PRICE_INVESTIGATOR_YEAR=""
STRIPE_PRICE_FOUNDING_MONTH=""
STRIPE_PRICE_FOUNDING_YEAR=""
